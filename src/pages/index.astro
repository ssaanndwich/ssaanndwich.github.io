---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const recentNotes = allNotes
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="San Cheng - Product Designer, Builder, and More"
  isHome={true}
>
  <section aria-labelledby="welcome-heading">
    <div class="jumbotron flex-container">
      <div class="left flex flex-direction">
        <img src="/imgs/name.svg" alt="San Cheng" id="name-logo" />
        <h1 id="welcome-heading">Technical Designer</h1>
        <h3>Experienced data-driven designer &amp; creative builder with a knack for human-computer interaction, data, and media</h3>
        <section aria-labelledby="experience-heading" class="experience-heading">
          <div class="flex-container">
            <div>
              <h4>Currently</h4>
              <h3 class="ly">Leading <a href="https://8knot.xyz/" target="_blank">8Knot</a> + Open to fulltime roles</h3>
            </div>
            <div>
              <h4>Previously</h4>
              <h3 class="ly">Amazon, Exygy, Foodsmart</h3>
            </div>
          </div>
        </section>
      </div>
      <div class="right flex flex-direction" aria-labelledby="portrait-heading" aria-label="Portrait">
        <img id="portrait" src="/imgs/portrait.png" alt="Portrait of San" width="170vw" />
        <h4>Pronouns: they/them<br />
          A Favorite Emoji: 🪤<br /><br />
          <span id="divider">&middot; &mdash; &middot; &mdash;&mdash;&mdash; &middot;&#x2737;&middot; &mdash;&mdash;&mdash; &middot; &mdash; &middot;</span></h4>
        <div id="logos">
          <a href="mailto:anth3lia@gmail.com"><img class="bio-logo" src="https://www.svgrepo.com/show/479480/email-14.svg" alt="Email logo" /></a>
          <a href="https://www.linkedin.com/in/ssaann" target="_blank"><img class="bio-logo" src="https://www.svgrepo.com/show/332108/linkedin.svg" alt="LinkedIn logo" /></a>
          <a href="https://github.com/ssaanndwich/" target="_blank"><img class="bio-logo" src="/imgs/github.svg" alt="Github logo" /></a>
          <a href="https://tinyurl.com/cv-scheng" target="_blank"><img class="bio-logo" src="https://www.svgrepo.com/show/503016/document.svg" alt="PDF Resume" /></a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="projects-heading-1" aria-label="Projects">
    <h2 id="projects-heading-1">Ongoing Projects</h2>
    <div class="projects-grid">
      <ul>
        <li>
          <article>
            <h5>Portfolio</h5>
            <p>Designing and building this website with HTML, CSS, and JavaScript using VS Code, Claude Code, GitHub, and Figma</p>
            <div class="card-footer">
              <div class="emoji">💻</div>
            </div>
          </article>
        </li>
        <li>
            <article>
                <h5>8Knot</h5>
                <p>Stewarded a 4-person team to develop an AI hackathon-winning app. Prototyped a <a tabindex="12" href="https://www.youtube.com/watch?v=zA8lncMpFPE" target="_blank">vehicle care app</a> based on motorcycling experience. Oversaw parts ordering amidst supply chain disruptions.</p>
                <div class="card-footer">
                    <div class="emoji">🛻</div>
                    <a tabindex="13" href="https://8knot.xyz" target="_blank">
                        <span class="link-text" >Visit the Site </span>
                        <span class="arrow" ><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" >
                        <path d="M12.5935 5.00098V13.5664H10.2596V8.72949L4.1248 14.8643L2.40605 13.1455L8.22245 7.33008H4.02714V5.00098H10.2596V5L12.5935 5.00098Z" fill="currentColor"/></svg></span>
                    </a>
                </div>
            </article>
            <video type="video/webm" src="/vids/revv_cover.webm" autoplay loop muted alt="POV motorcycle riding video"></video>
        </li>
        <li>
            <article>
                <h5>GrabGrab</h5>
                <p>Designing, developing, illustrating, and publishing a choice-driven narrative game</p>
                <div class="card-footer">
                    <div class="emoji" tabindex="14">🦞</div>
                </div>
            </article>
            <video type="video/webm" src="/vids/cd_cover.webm" autoplay loop muted alt="Pitch at Entrepreneurs First"></video>
        </li>
      </ul>
    </div>
  </section>
 
  <section aria-labelledby="projects-heading-2" aria-label="Projects">
      <h2 id="projects-heading-2">Launched Projects</h2>
      <div class="projects-grid">
            <ul>
                <li>
                    <article>
                        <h5>Amazon</h5>
                        <p>Launched Kindle Page Flip and Bookmarks for Kindle Paperwhite across 145 countries and supporting 9 languages</p>
                        <div class="card-footer">
                            <div class="emoji">📖</div>
                            <a tabindex="15" href="https://www.amazon.com/All-new-Amazon-Kindle-Paperwhite-glare-free/dp/B0CFPJYX7P" target="_blank">
                                <span class="link-text">Buy the Paperwhite </span>
                                <span class="arrow">
                                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12.5935 5.00098V13.5664H10.2596V8.72949L4.1248 14.8643L2.40605 13.1455L8.22245 7.33008H4.02714V5.00098H10.2596V5L12.5935 5.00098Z" fill="currentColor" />
                                  </svg>
                                <!-- Then <a href="https://www.youtube.com/watch?v=Qtk7ERwlIAk" target="_blank">jailbreak your Kindle</a> -->
                                </span>
                            </a>
                        </div>
                    </article>
                    <video type="video/webm" src="/vids/amzn_cover.webm" autoplay loop muted alt="Page Flip on the Kindle Paperwhite promo video"></video>
                </li>
                <li>
                    <article>
                        <h5>Foodsmart</h5>
                        <p>Delivered B2B healthcare enterprise core platform, culture, and process improvements, resulting in $25m+ Series C funding</p>
                        <div class="card-footer">
                            <div class="emoji">🥗</div>
                            <a tabindex="16" href="https://www.figma.com/design/rpYv1gQZ0csp7akUfdYcVL/Foodsmart--abridged-?node-id=0-1&t=W1FY9AdcQDkf0kKN-1" target="_blank">
                                <span class="link-text">Request Access </span>
                                <span class="arrow"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.5935 5.00098V13.5664H10.2596V8.72949L4.1248 14.8643L2.40605 13.1455L8.22245 7.33008H4.02714V5.00098H10.2596V5L12.5935 5.00098Z" fill="currentColor"/></svg></span>
                            </a>
                        </div>
                    </article>
                    <video type="video/webm" src="/vids/fs3b_cover.webm" autoplay loop muted alt="Foodsmart Video Call"></video>
                </li>
                <li>
                    <article>
                        <h5>Girls Who Code</h5>
                        <p>Led Exygy design and research to improve 3rd-12th grade tech education equity</p>
                        <div class="card-footer">
                            <div class="emoji">🛼</div>
                            <a tabindex="17" href="https://girlswhocode.com/" target="_blank">
                                <span class="link-text">Go to Website</span>
                                <span class="arrow"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.5935 5.00098V13.5664H10.2596V8.72949L4.1248 14.8643L2.40605 13.1455L8.22245 7.33008H4.02714V5.00098H10.2596V5L12.5935 5.00098Z" fill="currentColor"/></svg></span>
                            </a>
                        </div>
                    </article>
                    <video type="video/webm" src="/vids/gwc_cover.webm" autoplay loop muted alt="Girls Who Code avatars"></video>
                </li>
                <li>
                    <article>
                        <h5>YMCA</h5>
                        <p>Designed workflows at Exygy for YMCA of Silicon Valley's 13 branches' childcare and camps supporting local Bay Area communities</p>
                        <div class="card-footer">
                            <div class="emoji">🩳</div>
                            <a tabindex="18" href="https://www.ymcasv.org/" target="_blank">
                                <span class="link-text">Go to Website</span>
                                <span class="arrow"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.5935 5.00098V13.5664H10.2596V8.72949L4.1248 14.8643L2.40605 13.1455L8.22245 7.33008H4.02714V5.00098H10.2596V5L12.5935 5.00098Z" fill="currentColor"/></svg>
                                </span>
                            </a>
                        </div>
                    </article>
                    <video type="video/webm" src="/vids/ymca_cover.webm" autoplay loop muted alt="YMCA of Silicon Valley promo video" ></video>
                </li>
                <li>
                    <article>
                        <h5>U of Hawai'i</h5>
                        <p>Led Exygy redesigns to preserve globally endangered languages. A Google.org, University of Hawai'i-Manoa, and First Nations collaboration</p>
                        <div class="card-footer">
                            <div class="emoji">👁️</div>
                            <a tabindex="19" href="https://blog.google/outreach-initiatives/arts-culture/endangered-languages-project-supporting/" target="_blank">
                                <span class="link-text">Read More</span>
                                <span class="arrow"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.5935 5.00098V13.5664H10.2596V8.72949L4.1248 14.8643L2.40605 13.1455L8.22245 7.33008H4.02714V5.00098H10.2596V5L12.5935 5.00098Z" fill="currentColor"/></svg>
                                </span>
                            </a>
                        </div>
                    </article>
                    <video type="video/mp4" src="/vids/elp_cover.mp4" autoplay loop muted alt="Endangered Languages Project"></video>
                </li>
          </ul>
      </div>
  </section>

  <section aria-labelledby="notes-heading" aria-label="Notes">
    <h2 id="notes-heading">Latest Notes</h2>
    <ul class="lines">
      {recentNotes.map((note) => (
        <li>
          <a href={`/notes/${note.id}`}>
            <h3>{note.data.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
