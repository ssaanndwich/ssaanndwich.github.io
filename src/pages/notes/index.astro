---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);

function wordCountOf(body: string | undefined) {
  const plain = (body ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  return plain.length ? plain.split(' ').length : 0;
}

const notes = allNotes
  .map((note) => {
    const wordCount = wordCountOf(note.body);
    return {
      slug: note.id,
      title: note.data.title,
      date: note.data.date,
      tags: note.data.tags,
      wordCount,
    };
  })
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Group by year, most recent year first
const byYear = new Map<number, typeof notes>();
for (const note of notes) {
  const year = note.date.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(note);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

// Tag counts across all notes, most-used first
const tagCounts = new Map<string, number>();
for (const note of notes) {
  for (const tag of note.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title="Notes / San Cheng">
  <section aria-labelledby="notes-heading">
    <h1 id="notes-heading">Notes</h1>

    {tags.length > 0 && (
      <div class="tag-carousel">
          <div class="tag-carousel">
            <button type="button" class="tag-arrow" data-dir="-1" tabindex="6" aria-label="Scroll tags left" hidden>&#9668;</button>
            <div class="tag-filters" tabindex="-1" role="group" aria-label="Filter notes by tag">
              <button type="button" class="tag-pill active" data-tag="" tabindex="7">
                <img src="/imgs/icons/all.svg" alt="All" />
                <span class="tag-label">All</span>
                <span class="count">{notes.length}</span>
              </button>
              {tags.map(([tag, count], i) => (
                <button type="button" class="tag-pill" data-tag={tag} tabindex={8 + i}>
                  <img src={`/imgs/icons/${tag}.svg`} alt="" />
                  <span class="tag-label">{tag}</span>
                  <span class="count">{count}</span>
                </button>
              ))}
            </div>
            <button type="button" class="tag-arrow" data-dir="1" tabindex={8 + tags.length} aria-label="Scroll tags right" hidden>&#9654;</button>
          </div>
        </div>
    )}

    <p class="empty-state" hidden>No notes match that tag yet.</p>

    {years.map((year) => (
      <div class="year-group" data-year={year}>
        <h2 class="year-heading">{year}</h2>
        <ul class="lines">
          {byYear.get(year)!.map((note) => (
            <li data-tags={note.tags.join(',')}>
              <a href={`/notes/${note.slug}`}>
                <h3>{note.title}</h3>
              </a>
              <p class="note-row-meta">
                <span>{formatDate(note.date)}</span>
                <span class="meta-sep">&middot;</span>
                <span>{note.wordCount} words</span>
                {note.tags.length > 0 && <span class="meta-sep">&middot;</span>}
                {note.tags.map((t) => <span class="row-tag">{t}</span>)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const initialTag = params.get('tag') ?? '';

  const pills = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
  const yearGroups = document.querySelectorAll<HTMLDivElement>('.year-group');
  const emptyState = document.querySelector<HTMLParagraphElement>('.empty-state');

  function applyFilter(tag: string) {
    pills.forEach((pill) => {
      pill.classList.toggle('active', pill.dataset.tag === tag);
    });

    let anyVisible = false;
    yearGroups.forEach((group) => {
      let groupHasVisible = false;
      group.querySelectorAll<HTMLLIElement>('li').forEach((row) => {
        const rowTags = (row.dataset.tags ?? '').split(',');
        const match = tag === '' || rowTags.includes(tag);
        row.hidden = !match;
        if (match) groupHasVisible = true;
      });
      group.hidden = !groupHasVisible;
      if (groupHasVisible) anyVisible = true;
    });

    if (emptyState) emptyState.hidden = anyVisible;

    const url = new URL(window.location.href);
    if (tag) url.searchParams.set('tag', tag);
    else url.searchParams.delete('tag');
    window.history.replaceState({}, '', url);
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      applyFilter(btn.dataset.tag ?? '');
    });
  });

  if (initialTag) applyFilter(initialTag);

  const rail = document.querySelector<HTMLDivElement>('.tag-filters');
  const arrows = document.querySelectorAll<HTMLButtonElement>('.tag-arrow');

  function updateArrows() {
    if (!rail) return;
    const max = rail.scrollWidth - rail.clientWidth;
    arrows.forEach((a) => {
      const dir = Number(a.dataset.dir);
      const shouldHide = max <= 1 || (dir < 0 ? rail.scrollLeft <= 0 : rail.scrollLeft >= max - 1);
      if (shouldHide && document.activeElement === a) rail.focus();
      a.hidden = shouldHide;
    });
  }

  arrows.forEach((a) => {
    a.addEventListener('click', () => {
      if (!rail) return;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      rail.scrollBy({
        left: Number(a.dataset.dir) * rail.clientWidth * 0.8,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    });
  });

  rail?.addEventListener('scroll', updateArrows);
  window.addEventListener('resize', updateArrows);
  updateArrows();
</script>